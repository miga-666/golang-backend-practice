{
  "info": {
    "_postman_id": "74170c0b-1f27-43b1-b267-51815c8d3246",
    "name": "ginBackend testing",
    "description": "This collection covers the core user authentication and account management endpoints for the Gin backend service. It includes the following operations:\n\n- **User Registration** (`POST /user/register`) — Creates a new user account.\n    \n- **User Login** (`POST /user/login`) — Authenticates an existing user and returns an access token.\n    \n- **Change Password** (`PUT /user/password`) — Allows an authenticated user to update their password.\n    \n\nAll requests use the `{{baseUrl}}` environment variable to target the appropriate server, and authenticated requests rely on the `{{token}}` variable for authorization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "54283976",
    "_collection_link": "https://go.postman.co/collection/54283976-74170c0b-1f27-43b1-b267-51815c8d3246?source=collection_link"
  },
  "item": [
    {
      "name": "使用者註冊",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"testuser@example.com\",\r\n  \"password\": \"password123\"\r\n}\r\n\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/user/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "register"
          ],
          "query": [
            {
              "key": "email",
              "value": "test1@gmail.com",
              "disabled": true
            },
            {
              "key": "password",
              "value": "123",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "使用者登入",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"testuser@example.com\",\r\n  \"password\": \"password123\"\r\n}\r\n\r\n// remember to set the token in response on success to the environment variable 'token' for future requests.\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/user/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "修改密碼",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"testuser@example.com\",\r\n  \"oldPassword\": \"ppp\",\r\n  \"newPassword\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/user/password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "password"
          ]
        }
      },
      "response": []
    }
  ],
